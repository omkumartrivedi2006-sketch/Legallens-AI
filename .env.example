# ==========================================================
# LegalLens AI — Environment Configuration Template
# ==========================================================
# Note: Copy this file to .env.local for local development.
# Do NOT commit actual credentials or private keys to git.

# Application
VITE_APP_NAME="LegalLens AI"
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:5173"

# Firebase Authentication (Phase 2 — Module 1)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional: Firebase Local Emulator Suite
# Set to "true" to point authentication to a local emulator instance (default: http://localhost:9099)
VITE_USE_FIREBASE_EMULATOR="false"
VITE_FIREBASE_AUTH_EMULATOR_URL="http://localhost:9099"

# Backend Server & Google Gemini API (Phase 4 — Server-side only, never expose to client)
PORT=5000
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Backend API Endpoint for Frontend Client
VITE_BACKEND_API_URL=""

